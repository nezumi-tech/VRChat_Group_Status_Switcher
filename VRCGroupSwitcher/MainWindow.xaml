<Window x:Class="VRCGroupSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:VRCGroupSwitcher.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="720" Width="1080"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Icon="app_icon.png"
        Background="#0B0F19" Foreground="#F8FAFC">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullToVis"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="InvertNullToVis" Invert="True"/>
        <converters:StatusColorConverter x:Key="StatusColor"/>
        <converters:StatusTextConverter x:Key="StatusText"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#151C2C"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0EA5E9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP UPDATE BANNER (Visible across whole app when update is available) -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#0284C7" BorderThickness="0,0,0,2" Padding="20,10"
                Visibility="{Binding HasUpdateNotification, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🎉" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="新しいバージョンが公開されました！" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC"/>
                        <Border Background="#0284C7" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding LatestVersion, StringFormat='v{0}'}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="BOOTHにて最新版をダウンロードいただけます。" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="📦 BOOTHでダウンロード" Height="32" Padding="14,0" FontSize="12" Click="BtnOpenBooth_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="✕" Width="32" Height="32" Padding="0" FontSize="12" Click="BtnDismissUpdate_Click" ToolTip="閉じる"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body Area -->
        <Grid Grid.Row="1">
            <!-- Main Application Shell (Visible when logged in) -->
            <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#0F1420" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                <Grid Margin="16,20,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- App Title -->
                    <StackPanel Grid.Row="0" Margin="4,0,0,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="VRC Group Switcher" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Group &amp; Status Auto Sync" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavRadioButton}" Content="📊  ダッシュボード" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavGroups" Style="{StaticResource NavRadioButton}" Content="👥  所属グループ" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavRules" Style="{StaticResource NavRadioButton}" Content="⚙️  切替ルール" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadioButton}" Content="🔧  一般設定" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLogs" Style="{StaticResource NavRadioButton}" Content="📜  動作ログ" Checked="Nav_Checked"/>
                    </StackPanel>

                    <!-- User Profile Card (Bottom of sidebar) -->
                    <Border Grid.Row="3" Background="#172033" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#334155" Margin="0,0,10,0">
                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" Width="36" Height="36">
                                    <Image.Clip>
                                        <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                                    </Image.Clip>
                                </Image>
                            </Border>

                            <!-- Name & Status -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{Binding UserStatus, Converter={StaticResource StatusColor}}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding UserStatus, Converter={StaticResource StatusText}}" FontSize="11" Foreground="{Binding UserStatus, Converter={StaticResource StatusColor}}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Logout Button -->
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="6,4" ToolTip="ログアウト" Click="BtnLogout_Click" VerticalAlignment="Center">
                                <TextBlock Text="🚪" FontSize="12"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT CONTENT AREA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR -->
                <Border Grid.Row="0" Background="#0F1420" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- VRChat Instance Detection Status -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                     Fill="{Binding IsVRChatActive, Converter={StaticResource BoolToVis}, ConverterParameter=BrushActive}"/>
                            <TextBlock Text="現在ワールド:" Foreground="#94A3B8" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentWorldName}" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
                            <TextBlock Text="{Binding DetectedGroupId, StringFormat=' [{0}]'}" Foreground="#64748B" FontSize="12" Margin="4,1,0,0"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding CurrentInstanceType, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding CurrentInstanceType}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- Top Action Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Auto Switch Toggle -->
                            <Border Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding AutoSwitchEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Text="自動切り替え" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Quick Revert Button -->
                            <Button Style="{StaticResource SecondaryButton}" Content="🔄 デフォルトに復帰" Click="BtnQuickRevert_Click" Margin="0,0,8,0"/>
                            <!-- Refresh Groups -->
                            <Button Style="{StaticResource SecondaryButton}" Content="🔁 グループ更新" Click="BtnRefreshGroups_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN TAB CONTENTS -->
                <Grid Grid.Row="1" Margin="24">

                    <!-- TAB 1: DASHBOARD -->
                    <Grid x:Name="TabDashboardView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Hero Cards -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Current Banner Card -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="👥 現在掲示中のグループ" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC"/>
                                        <TextBlock Text="(VRChatネームプレートに表示)" FontSize="11" Foreground="#64748B" Margin="8,3,0,0"/>
                                    </StackPanel>

                                    <!-- Banner Image or Placeholder -->
                                    <Border Grid.Row="1" Height="100" CornerRadius="8" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding CurrentRepresentedGroup.BannerUrl}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Text="バナー未設定 / 掲示なし" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding CurrentRepresentedGroup.BannerUrl, Converter={StaticResource InvertNullToVis}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Group Info & Actions -->
                                    <Grid Grid.Row="2" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding CurrentRepresentedGroup.Name, FallbackValue='(掲示グループなし)'}" FontWeight="Bold" FontSize="15" Foreground="#38BDF8"/>
                                            <TextBlock Text="{Binding CurrentRepresentedGroup.DisplayCode, FallbackValue=''}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButton}" Content="バナー解除" Click="BtnClearBanner_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Current Status Card -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="💬 ユーザーステータス" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC" Margin="0,0,0,12"/>

                                    <StackPanel Grid.Row="1">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse Width="12" Height="12" Fill="{Binding UserStatus, Converter={StaticResource StatusColor}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding UserStatus, Converter={StaticResource StatusText}}" FontWeight="Bold" FontSize="14" Foreground="{Binding UserStatus, Converter={StaticResource StatusColor}}"/>
                                        </StackPanel>

                                        <TextBlock Text="ステータスメッセージ:" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding UserStatusDescription, FallbackValue='(未設定)'}" FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Quick Revert Default Info -->
                                    <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="📌 デフォルト復帰設定:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding DefaultGroupName, StringFormat='バナー: {0}'}" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DefaultStatus, Converter={StaticResource StatusText}, StringFormat='ステータス: {0}'}" FontSize="12" Foreground="{Binding DefaultStatus, Converter={StaticResource StatusColor}}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Bottom Section: Quick Rules / Recent Logs -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Active Rules Preview -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="⚙️ 設定中の自動切替ルール" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="+ 追加" HorizontalAlignment="Right" Click="BtnAddRule_Click"/>
                                    </DockPanel>

                                    <ListBox Grid.Row="1" ItemsSource="{Binding CustomRules}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E293B" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13"/>
                                                            <TextBlock Text="{Binding TargetValue, StringFormat='条件: {0}'}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding TargetGroupName, StringFormat='適用: {0}'}" Foreground="#38BDF8" FontSize="11"/>
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Live Activity Log Preview -->
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="📜 リアルタイム動作ログ" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" Margin="0,0,0,10"/>

                                    <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLogs}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{Binding TimeString}" Foreground="#64748B" FontSize="11" Width="55"/>
                                                    <TextBlock Text="{Binding Message}" Foreground="{Binding ColorHex}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- TAB 2: GROUPS LIST (MY GROUPS) -->
                    <Grid x:Name="TabGroupsView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top Toolbar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="👥 所属グループ一覧" FontWeight="Bold" FontSize="18" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Groups.Count, StringFormat=' ({0} 件)'}" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="再読み込み" HorizontalAlignment="Right" Click="BtnRefreshGroups_Click"/>
                        </DockPanel>

                        <!-- Groups Items Control -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Width="310" Margin="0,0,16,16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="90"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Banner image -->
                                                <Border Grid.Row="0" CornerRadius="6" Background="#0F172A" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding BannerUrl}" Stretch="UniformToFill"/>
                                                        <Border Background="#99000000" VerticalAlignment="Top" HorizontalAlignment="Right" Padding="6,2" CornerRadius="0,6,0,6"
                                                                Visibility="{Binding IsRepresenting, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="🌟 掲示中" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Info -->
                                                <StackPanel Grid.Row="1" Margin="0,10,0,10">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                                    <DockPanel Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding DisplayCode}" Foreground="#38BDF8" FontSize="11"/>
                                                        <TextBlock Text="{Binding MemberCount, StringFormat='メンバー: {0:N0}人'}" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right"/>
                                                    </DockPanel>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="今すぐ掲示" Margin="0,0,4,0" Padding="8,6" FontSize="12" Click="BtnSwitchToThisGroup_Click"/>
                                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="デフォルト指定" Margin="4,0,0,0" Padding="8,6" FontSize="12" Click="BtnSetAsDefaultGroup_Click"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 3: RULES (STABLE CARD-BASED LIST) -->
                    <Grid x:Name="TabRulesView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="⚙️ 自動切り替えルール管理" FontWeight="Bold" FontSize="18" Foreground="#F8FAFC"/>
                                <TextBlock Text="特定のグループインスタンスやワールドに入退室したときの動作を定義します。" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+ 新規ルール追加" HorizontalAlignment="Right" Click="BtnAddRule_Click"/>
                        </DockPanel>

                        <!-- Auto Follow Group Instance Section -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox IsChecked="{Binding AutoFollowGroupInstance, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Text="グループインスタンス自動追従モード (推奨)" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="~group(grp_...) 形式のグループインスタンスに入った際、所属グループであれば自動でそのグループのバナーを掲示します。" Foreground="#94A3B8" FontSize="12" Margin="24,0,0,0" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- Custom Rules Card List (Crash-free & Beautiful) -->
                        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="個別カスタムルール一覧" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CustomRules.Count, StringFormat=' ({0} 件)'}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </DockPanel>

                                <!-- ListBox of Rules -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ListBox ItemsSource="{Binding CustomRules}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,0,8"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Enable Checkbox -->
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                                        <!-- Details -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
                                                                <Border Background="#0F172A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TargetType, StringFormat='タイプ: {0}'}" FontSize="11" Foreground="#38BDF8"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding TargetValue, StringFormat='条件値: {0}'}" Foreground="#94A3B8" FontSize="12" Margin="0,0,16,0"/>
                                                                <TextBlock Text="{Binding TargetGroupName, StringFormat='適用バナー: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0"/>
                                                                <TextBlock Text="{Binding TargetStatus, Converter={StaticResource StatusText}, StringFormat='ステータス: {0}'}" Foreground="{Binding TargetStatus, Converter={StaticResource StatusColor}}" FontSize="12"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Action Buttons -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource SecondaryButton}" Content="編集" Padding="12,6" FontSize="12" Margin="0,0,8,0" Click="BtnEditRule_Click"/>
                                                            <Button Style="{StaticResource SecondaryButton}" Content="削除" Padding="12,6" FontSize="12" Foreground="#EF4444" Click="BtnDeleteRule_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 4: SETTINGS -->
                    <Grid x:Name="TabSettingsView" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <TextBlock Text="🔧 一般・デフォルト設定" FontWeight="Bold" FontSize="18" Foreground="#F8FAFC" Margin="0,0,0,16"/>

                                <!-- Default Settings Section -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="📌 通常時 (デフォルト) 設定" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,12"/>
                                        <TextBlock Text="イベント外や、対象グループインスタンスを退出した際に復帰する設定です。" Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>

                                        <TextBlock Text="デフォルト掲示グループ" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CmbDefaultGroup" ItemsSource="{Binding Groups}" DisplayMemberPath="Name" SelectedValuePath="GroupId"
                                                      SelectedValue="{Binding DefaultGroupId, Mode=TwoWay}"/>
                                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="解除" Click="BtnClearDefaultGroup_Click" Margin="8,0,0,0" ToolTip="デフォルト掲示グループを解除して(バナーなし)にします"/>
                                        </Grid>

                                        <TextBlock Text="デフォルトステータス" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CmbDefaultStatus" SelectedValuePath="Tag" SelectedValue="{Binding DefaultStatus, Mode=TwoWay}" Margin="0,0,0,12">
                                            <ComboBoxItem Content="変更しない (維持)" Tag="unchanged" Foreground="#94A3B8"/>
                                            <ComboBoxItem Content="だれでもおいで (Join Me)" Tag="join me" Foreground="#38BDF8"/>
                                            <ComboBoxItem Content="オンライン (Active)" Tag="active" Foreground="#4ADE80"/>
                                            <ComboBoxItem Content="きいてみてね (Ask Me)" Tag="ask me" Foreground="#FB923C"/>
                                            <ComboBoxItem Content="取り込み中 (Busy)" Tag="busy" Foreground="#F87171"/>
                                        </ComboBox>

                                        <TextBlock Text="デフォルトステータスメッセージ" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DefaultStatusDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                        <CheckBox IsChecked="{Binding RevertOnLeave, Mode=TwoWay}" Content="インスタンス退出時に自動でデフォルトに復帰する" Foreground="#F8FAFC" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Group Instance Type Reaction Settings -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="👥 グループインスタンス反応設定" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,12"/>
                                        <TextBlock Text="ログ解析で自動切り替えの対象とするグループインスタンスの種類を選択します。" Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>

                                        <CheckBox IsChecked="{Binding ReactToGroupOnly, Mode=TwoWay}" Content="グループオンリー (Group Only / メンバー限定)" Foreground="#F8FAFC" Margin="0,4,0,4"/>
                                        <TextBlock Text="※グループメンバーのみが入室できるインスタンスで自動切り替えを行います。" Foreground="#64748B" FontSize="11" Margin="24,0,0,10"/>

                                        <CheckBox IsChecked="{Binding ReactToGroupPlus, Mode=TwoWay}" Content="グループプラス (Group+ / フレンド合流可)" Foreground="#F8FAFC" Margin="0,4,0,4"/>
                                        <TextBlock Text="※メンバーのフレンドも合流できるインスタンスで自動切り替えを行います。" Foreground="#64748B" FontSize="11" Margin="24,0,0,10"/>

                                        <CheckBox IsChecked="{Binding ReactToGroupPublic, Mode=TwoWay}" Content="グループパブリック (Group Public / 一般公開)" Foreground="#F8FAFC" Margin="0,4,0,4"/>
                                        <TextBlock Text="※グループ主催のパブリックインスタンスで自動切り替えを行います。" Foreground="#64748B" FontSize="11" Margin="24,0,0,4"/>
                                    </StackPanel>
                                </Border>

                                <!-- Switching behavior settings -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="⏱️ 動作タイミング" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,12"/>
                                        <TextBlock Text="切り替え判定待機ディレイ (秒)" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SwitchDelaySeconds, Mode=TwoWay}" ToolTip="ワールド移動時の誤動作を防ぐための秒数 (推奨: 3秒)" Margin="0,0,0,8"/>
                                        <TextBlock Text="※短時間のワールド通過やローディング中の連続リクエストを防ぐため、安定後に切り替えます。" Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <!-- Background & Startup settings -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="🚀 常駐・スタートアップ設定" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,12"/>
                                        <TextBlock Text="アプリをバックグラウンドで動作させ、常にワールド移動を検知できるようにします。" Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>

                                        <CheckBox IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Content="最小化ボタンでタスクトレイに格納する" Foreground="#F8FAFC" Margin="0,4,0,4"/>
                                        <TextBlock Text="※ウィンドウ最小化時にタスクバーから消え、タスクトレイ（通知領域）に格納されます。" Foreground="#64748B" FontSize="11" Margin="24,0,0,12"/>

                                        <CheckBox IsChecked="{Binding CloseToTray, Mode=TwoWay}" Content="閉じるボタン (×) でタスクトレイに常駐する" Foreground="#F8FAFC" Margin="0,4,0,4"/>
                                        <TextBlock Text="※「×」ボタンを押してもアプリを終了せず、トレイで動作を継続します（終了はトレイアイコン右クリックから行えます）。" Foreground="#64748B" FontSize="11" Margin="24,0,0,12"/>

                                        <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Content="Windows起動時に自動起動する (タスクトレイ常駐)" Foreground="#F8FAFC" Margin="0,4,0,4"/>
                                        <TextBlock Text="※PC起動時に画面を表示せず、タスクトレイに格納された状態で自動的に常駐開始します。" Foreground="#64748B" FontSize="11" Margin="24,0,0,4"/>
                                    </StackPanel>
                                </Border>

                                <!-- App Info -->
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="ℹ️ アプリケーション情報" FontWeight="Bold" FontSize="14" Foreground="#38BDF8" Margin="0,0,0,12"/>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="アプリケーション名" Foreground="#94A3B8" FontSize="12"/>
                                            <TextBlock Text="VRC Group Switcher" Foreground="#F8FAFC" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,2">
                                            <TextBlock Text="バージョン" Foreground="#94A3B8" FontSize="12"/>
                                            <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" Foreground="#F8FAFC" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,2">
                                            <TextBlock Text="ランタイム環境" Foreground="#94A3B8" FontSize="12"/>
                                            <TextBlock Text=".NET 10.0 (WPF / win-x64)" Foreground="#64748B" FontSize="12" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Separator Background="#1E293B" Margin="0,10"/>
                                        <Grid Margin="0,2">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="アップデート状況" Foreground="#94A3B8" FontSize="12"/>
                                                <TextBlock Text="{Binding UpdateCheckStatusText}" Foreground="#38BDF8" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource SecondaryButton}" Content="🔄 更新を確認" Height="30" Padding="10,0" FontSize="11"
                                                        Click="BtnCheckUpdateManual_Click" IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBool}}" Margin="0,0,6,0"/>
                                                <Button Style="{StaticResource PrimaryButton}" Content="📦 BOOTHを開く" Height="30" Padding="10,0" FontSize="11"
                                                        Click="BtnOpenBooth_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 5: LOGS -->
                    <Grid x:Name="TabLogsView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="📜 詳細動作ログ履歴" FontWeight="Bold" FontSize="18" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="ログ消去" HorizontalAlignment="Right" Click="BtnClearLogs_Click"/>
                        </DockPanel>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                            <ListBox ItemsSource="{Binding ActivityLogs}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="{Binding TimeString}" Foreground="#64748B" FontSize="12" Width="65"/>
                                            <TextBlock Text="{Binding Message}" Foreground="{Binding ColorHex}" FontSize="13" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>

        <!-- LOGIN OVERLAY (Visible when NOT logged in) -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource InvertBoolToVis}}" Background="#0B0F19">
            <Border Width="440" Style="{StaticResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,32">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🌐 VRC Group Switcher" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="VRChatアカウントでログインしてください" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                    <TextBlock Text="ユーザー名 または メールアドレス" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtLoginUsername" Text="{Binding LoginUsername, Mode=TwoWay}" MinHeight="44" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock Text="パスワード" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtLoginPassword" MinHeight="44" FontSize="14" Margin="0,0,0,16" KeyDown="TxtLoginPassword_KeyDown"/>

                    <TextBlock Text="{Binding LoginErrorMessage}" Foreground="#EF4444" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"
                               Visibility="{Binding LoginErrorMessage, Converter={StaticResource NullToVis}}"/>

                    <Button Style="{StaticResource PrimaryButton}" Content="ログイン" Height="44" FontSize="14" Click="BtnLogin_Click"
                            IsEnabled="{Binding IsLoggingIn, Converter={StaticResource InvertBoolToVis}}"/>

                    <ProgressBar Height="4" Margin="0,12,0,0" IsIndeterminate="True"
                                 Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{Binding LoginStatusText}" Foreground="#38BDF8" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"
                               Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}"/>

                    <Border Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,20,0,0">
                        <TextBlock Text="🔒 パスワードは一切端末に保存されません。認証成功時に取得されるセッションCookieのみがWindows DPAPIにより暗号化保存され、次回以降の自動ログインに使用されます。"
                                   Foreground="#64748B" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
