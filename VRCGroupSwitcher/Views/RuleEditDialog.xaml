<Window x:Class="VRCGroupSwitcher.Views.RuleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ルールの設定" Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚙️ カスタムルールの編集" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Rule Name -->
                <TextBlock Text="ルール名" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Text="イベント集会所ルール" Margin="0,0,0,12"/>

                <!-- Condition Type -->
                <TextBlock Text="発火条件タイプ" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbTargetType" SelectionChanged="CmbTargetType_SelectionChanged" Margin="0,0,0,12">
                    <ComboBoxItem Content="グループインスタンス (grp_...)" Tag="GroupInstance" IsSelected="True"/>
                    <ComboBoxItem Content="ワールドID (wrld_...)" Tag="WorldId"/>
                    <ComboBoxItem Content="ワールド名 (部分一致)" Tag="WorldName"/>
                </ComboBox>

                <!-- Condition Value -->
                <TextBlock x:Name="LblTargetValue" Text="条件値 (所属グループ選択 または グループID grp_...)" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbConditionGroup" DisplayMemberPath="Name" SelectedValuePath="GroupId" SelectionChanged="CmbConditionGroup_SelectionChanged" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <TextBox x:Name="TxtTargetValue" ToolTip="grp_xxxxxxxx または wrld_xxxxxxxx または ワールド名" Margin="0"/>
                    <TextBlock x:Name="TxtTargetValuePlaceholder" Text="grp_..." Foreground="#64748B" FontSize="14"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtTargetValue}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Target Group -->
                <TextBlock Text="切り替えるグループバナー" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbTargetGroup" DisplayMemberPath="Name" SelectedValuePath="GroupId" Margin="0,0,0,12"/>

                <!-- Target Status -->
                <TextBlock Text="切り替えるステータス" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbTargetStatus" Margin="0,0,0,12">
                    <ComboBoxItem Content="変更しない (維持)" Tag="unchanged" IsSelected="True" Foreground="#94A3B8"/>
                    <ComboBoxItem Content="だれでもおいで (Join Me)" Tag="join me" Foreground="#38BDF8"/>
                    <ComboBoxItem Content="オンライン (Active)" Tag="active" Foreground="#4ADE80"/>
                    <ComboBoxItem Content="きいてみてね (Ask Me)" Tag="ask me" Foreground="#FB923C"/>
                    <ComboBoxItem Content="取り込み中 (Busy)" Tag="busy" Foreground="#F87171"/>
                </ComboBox>

                <!-- Status Description -->
                <TextBlock Text="ステータスメッセージ (任意: {group_name}, {world_name} 利用可)" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtStatusDesc" Text="{}{group_name} イベント参加中" Margin="0,0,0,12"/>

                <!-- Enable Checkbox -->
                <CheckBox x:Name="ChkEnabled" Content="このルールを有効にする" IsChecked="True" Foreground="#F8FAFC" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Background="#334155" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="保存する" Background="#10B981" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
